# ============================================================
# 本地敏感配置模板
# 使用方式：复制本文件为 application-local.yaml 并填入实际值
#           application-local.yaml 已被 .gitignore 忽略，不会提交
# ============================================================
spring:
  data:
    redis:
      # 本机 Redis 未设置密码时留空
      password:
  datasource:
    # MySQL 密码
    password: your-db-password
  ai:
    openai:
      # 阿里云 DashScope API Key（OpenAI 兼容模式）
      api-key: sk-your-dashscope-api-key

article:
  pexels:
    # Pexels 图片搜索 API Key
    api-key: your-pexels-api-key
  cos:
    # 腾讯云 COS 密钥（未配置时配图将直接复用源站 URL，不上传对象存储）
    secretId: your-cos-secret-id
    secretKey: your-cos-secret-key
    bucket: your-cos-bucket
  image:
    mermaid:
      # mermaid-cli(mmdc) 可执行文件路径，按本机安装位置填写
      mmdc-path: /path/to/mermaid-cli/node_modules/.bin/mmdc

pay:
  alipay:
    app-id: your-alipay-app-id
    private-key: your-alipay-private-key
    alipay-public-key: your-alipay-public-key
